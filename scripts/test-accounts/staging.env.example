# Copy to .env.staging at the repo root (gitignored) and fill in. See docs/TEST_ACCOUNTS.md.
# NEVER point this at the production project (mmomoyszozclfjdvjbeb) — the scripts refuse to run if you do.

# --- Read by the app (bundled into the dev build; client-safe values only) ---
EXPO_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<staging publishable key>
EXPO_PUBLIC_DEV_AUTH=true
EXPO_PUBLIC_APP_ENV=staging
# Serve the signed-in test persona's generated Health data instead of HealthKit (dev builds only).
EXPO_PUBLIC_FAKE_HEALTH=true
# Optional: force one persona's Health data regardless of who is signed in (ava, bea, cleo, dev, eli, fay).
# EXPO_PUBLIC_FAKE_HEALTH_PERSONA=

# --- Read only by scripts/test-accounts (never bundled; never prefix with EXPO_PUBLIC_) ---
# Staging project → Settings → API → service_role / secret key. Bypasses RLS: keep it on your machine.
SUPABASE_SERVICE_ROLE_KEY=
# Shared password for every test persona (min 8 characters). You type it in the app's dev email login.
TEST_PERSONA_PASSWORD=
