{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "app/*"
      ],
      "@domain/*": [
        "packages/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "app/**/*",
    "packages/**/*",
    "types/**/*"
  ]
}
